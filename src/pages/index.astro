---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';
import profile from '../data/profile.json';
import experience from '../data/experience.json';
import skills from '../data/skills.json';
import certifications from '../data/certifications.json';
import projects from '../data/projects.json';
import investigations from '../data/investigations.json';
import blog from '../data/blog.json';
import { Image } from 'astro:assets';
import profilePicture from '../assets/ProfilePicture.jpeg';
import { resolveImage } from '../lib/images';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const featuredProjects = projects.filter(p => p.featured);
const latestBlogs = blog.slice(0, 2);
const latestInvestigations = investigations.slice(0, 2);

const adInvestigation = `${base}/investigations/active-directory-lateral-movement/`;

const metrics = [
  { value: '4.1', decimals: 1, suffix: ' / 4.3', label: 'CGPA, B.Tech Networking & Cybersecurity', href: `${base}/#profile` },
  { value: '3', decimals: 0, suffix: '', label: 'Internships & training programs', href: `${base}/#experience` },
  { value: '140', decimals: 0, suffix: '+', label: 'API endpoints built in CyberNest SOAR', href: `${base}/projects/cybernest-soar` },
  { value: '2', decimals: 0, suffix: '', label: 'ATT&CK-mapped investigations', href: `${base}/investigations` },
];

const approachSteps = [
  { step: 'Observe', proof: 'Baseline authentication and Kerberos traffic for 24 hours before alerting.', href: adInvestigation },
  { step: 'Correlate', proof: 'Tie NTLM logon anomalies to the source hosts that generated them.', href: adInvestigation },
  { step: 'Map', proof: 'Map T1558.003 and T1550.002 to concrete detection rules.', href: adInvestigation },
  { step: 'Respond', proof: 'Drive block_ip, isolate_host, and create_case playbooks in CyberNest.', href: `${base}/projects/cybernest-soar` },
  { step: 'Document', proof: 'Publish a full report for every investigation.', href: `${base}/investigations` },
];
---
<Layout title="Paula Maged · SOC & Blue Team Cybersecurity Student" description="SOC and Blue Team cybersecurity student building detection engineering, incident response, and security automation projects.">
  <Nav />

  <main id="main-content">
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-accent-dim/20 via-transparent to-transparent pointer-events-none" />
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16 relative">
        <div class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-8">
          <div class="relative shrink-0 w-24 h-24 sm:w-28 sm:h-28 lg:w-32 lg:h-32">
            <div class="absolute -inset-2 rounded-full bg-gradient-to-tr from-accent/30 via-accent/5 to-transparent blur-xl" aria-hidden="true"></div>
            <Image
              src={profilePicture}
              alt={`Portrait of ${profile.name}`}
              width={256}
              height={308}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="relative w-full h-full object-cover object-[50%_22%] rounded-full ring-2 ring-accent/30 shadow-[0_18px_40px_-18px_rgba(0,0,0,0.85)]"
            />
          </div>
          <div class="min-w-0">
            <p class="text-accent text-sm font-mono tracking-widest uppercase mb-4">{profile.tagline ?? ''}</p>
            <h1 class="text-4xl sm:text-5xl font-bold text-[var(--text)] mb-4 tracking-tight">{profile.name}</h1>
            <p class="text-lg text-[var(--text-accent)] font-medium">{profile.title}</p>
          </div>
        </div>
        <p class="text-lg text-[var(--text-muted)] max-w-2xl mt-8 mb-8">{profile.bio}</p>
        <div class="flex flex-wrap gap-3 mb-10">
          {(profile.focus || []).map(f => (
            <span class="text-xs px-3 py-1 border border-[var(--border)] rounded-badge text-[var(--text-muted)] bg-[var(--bg-elevated)]">{f}</span>
          ))}
        </div>
        <div class="flex flex-wrap gap-4">
          <a href={`${base}/projects`} class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent text-bg font-semibold text-sm rounded-btn hover:opacity-90 transition-all duration-300">
            View Projects
            <span class="text-xs opacity-70">&rarr;</span>
          </a>
          {profile.links?.linkedin && <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 border border-[var(--border-strong)] text-[var(--text-muted)] text-sm rounded-btn hover:border-accent hover:text-accent transition-all duration-300">LinkedIn</a>}
          {profile.links?.github && <a href={profile.links.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 border border-[var(--border-strong)] text-[var(--text-muted)] text-sm rounded-btn hover:border-accent hover:text-accent transition-all duration-300">GitHub</a>}
          {profile.links?.resume && <a href={profile.links.resume} download class="inline-flex items-center gap-2 px-5 py-2.5 border border-[var(--border-strong)] text-[var(--text-muted)] text-sm rounded-btn hover:border-accent hover:text-accent transition-all duration-300">Download CV</a>}
          {profile.links?.email && <a href={`mailto:${profile.links.email}`} class="inline-flex items-center gap-2 px-5 py-2.5 border border-[var(--border-strong)] text-[var(--text-muted)] text-sm rounded-btn hover:border-accent hover:text-accent transition-all duration-300">Email</a>}
        </div>

        <section class="mt-10" aria-label="Highlights">
          <p class="inline-block px-3 py-1 border border-accent/60 rounded-full text-xs text-accent mb-5">{profile.availability}</p>
          <dl class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 m-0">
            {metrics.map(m => (
              <a href={m.href} class="group flex flex-col-reverse p-4 sm:p-5 border border-[var(--border)] rounded-card bg-[var(--bg-card)] no-underline text-inherit transition-all duration-200 hover:border-accent hover:-translate-y-0.5 focus-visible:border-accent focus-visible:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
                <dt class="mt-1.5 text-xs text-[var(--text-muted)] leading-snug">{m.label}</dt>
                <dd class="m-0 text-3xl sm:text-4xl font-bold leading-none text-[var(--text)]">
                  <span data-count={m.value} data-decimals={m.decimals}>{m.value}</span>
                  {m.suffix && <small class="text-base font-normal text-[var(--text-dim)]">{m.suffix}</small>}
                </dd>
              </a>
            ))}
          </dl>
        </section>

        <script is:inline>
          (() => {
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            document.querySelectorAll('[data-count]').forEach(el => {
              const target = parseFloat(el.dataset.count);
              const decimals = +(el.dataset.decimals || 0);
              const start = performance.now(), dur = 900;
              const tick = now => {
                const p = Math.min((now - start) / dur, 1);
                el.textContent = (target * (1 - Math.pow(1 - p, 3))).toFixed(decimals);
                if (p < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            });
          })();
        </script>
      </div>
    </section>


    <!-- Featured Projects Preview -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[var(--border)]">
      <div class="flex items-center justify-between mb-8">
        <div>
          <p class="text-accent text-xs font-mono tracking-widest uppercase mb-3">PROJECTS</p>
          <h2 class="text-2xl font-semibold text-[var(--text)]">Featured Projects</h2>
        </div>
        <a href={`${base}/projects`} class="text-sm text-[var(--text-muted)] hover:text-accent transition-all duration-300">View all &rarr;</a>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {featuredProjects.map(p => (
          <Card href={`${base}/projects/${p.slug}`} padding="5" class="group block">
            <div class="flex items-center gap-2 mb-2">
              <h3 class="text-[var(--text)] font-semibold text-sm group-hover:text-accent transition-all duration-300">{p.title}</h3>
              <span class:list={[
                "text-[10px] px-2 py-0.5 border rounded-badge",
                p.status === 'active' ? "bg-accent/20 text-accent border-accent/30" : "bg-[var(--bg-elevated)] text-[var(--text-dim)] border-[var(--border)]"
              ]}>{p.status}</span>
            </div>
            <p class="text-xs text-[var(--text-dim)] mb-2">{p.role} · {p.timeline}</p>
            <p class="text-sm text-[var(--text-muted)] mb-3 line-clamp-2">{p.description}</p>
            <div class="flex flex-wrap gap-1.5">
              {p.technologies.slice(0, 4).map(t => (
                <span class="text-[10px] px-2 py-0.5 border border-[var(--border)] rounded-badge text-[var(--text-dim)] bg-[var(--bg-elevated)]">{t}</span>
              ))}
            </div>
          </Card>
        ))}
      </div>
    </section>


    <!-- Recent Investigations Preview -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[var(--border)]">
      <div class="flex items-center justify-between mb-8">
        <div>
          <p class="text-accent text-xs font-mono tracking-widest uppercase mb-3">INVESTIGATIONS</p>
          <h2 class="text-2xl font-semibold text-[var(--text)]">Recent Investigations</h2>
        </div>
        <a href={`${base}/investigations`} class="text-sm text-[var(--text-muted)] hover:text-accent transition-all duration-300">View all &rarr;</a>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {latestInvestigations.map(inv => (
          <Card href={`${base}/investigations/${inv.slug}`} padding="5" class="group block overflow-hidden">
            {inv.pic && <Image src={resolveImage(inv.pic)} alt={inv.title} width={640} height={360} loading="lazy" decoding="async" class="w-full h-36 object-cover" />}
            <div class="p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[10px] px-2 py-0.5 bg-accent/20 text-accent border border-accent/30 rounded-badge">{inv.category}</span>
              <span class="text-[10px] text-[var(--text-dim)]">{inv.date}</span>
            </div>
            <h3 class="text-[var(--text)] font-semibold text-sm mb-2 group-hover:text-accent transition-all duration-300">{inv.title}</h3>
            <p class="text-sm text-[var(--text-muted)] line-clamp-2">{inv.summary}</p>
            </div>
          </Card>
        ))}
      </div>
    </section>


    <!-- How I Think -->
    <section id="approach" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[var(--border)] scroll-mt-20">
      <p class="text-accent text-xs font-mono tracking-widest uppercase mb-3">APPROACH</p>
      <h2 class="text-2xl font-semibold text-[var(--text)] mb-4">How I Approach Security</h2>
      <p class="text-sm text-[var(--text-muted)] max-w-2xl mb-8">I treat every alert as a loop, not a ticket, and I document each pass so the next analyst doesn't start from zero.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        {approachSteps.map((s, i) => (
          <a href={s.href} class="group flex flex-col rounded-card border border-[var(--border)] bg-[var(--bg-card)] p-4 no-underline transition-all duration-200 hover:border-accent/60 hover:-translate-y-0.5 focus-visible:border-accent focus-visible:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
            <span class="text-[10px] font-mono tracking-widest text-accent">0{i + 1}</span>
            <span class="mt-1 text-sm font-semibold text-[var(--text)] group-hover:text-accent transition-colors">{s.step}</span>
            <span class="mt-1 text-xs text-[var(--text-dim)] leading-relaxed">{s.proof}</span>
            <span class="mt-3 inline-flex items-center gap-1 text-[10px] text-[var(--text-dim)] group-hover:text-accent transition-colors">Evidence <span aria-hidden="true">&rarr;</span></span>
          </a>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[var(--border)] scroll-mt-20">
      <p class="text-accent text-xs font-mono tracking-widest uppercase mb-3">EXPERIENCE</p>
      <h2 class="text-2xl font-semibold text-[var(--text)] mb-8">Experience</h2>
      <div class="space-y-4">
        {experience.filter(exp => exp.type !== 'Education').map(exp => (
          <Card padding="5" class="flex flex-col sm:flex-row sm:items-start gap-4">
            {exp.pic && <a href={exp.pic} target="_blank" rel="noopener noreferrer" class="flex-shrink-0"><Image src={resolveImage(exp.pic)} alt={exp.company} width={112} height={112} fit="contain" loading="lazy" decoding="async" class="w-14 h-14 object-contain rounded-badge hover:opacity-80 transition-all duration-300" /></a>}
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <h3 class="text-[var(--text)] font-semibold text-sm">{exp.title}</h3>
                {exp.current && <span class="text-[10px] px-2 py-0.5 bg-success/20 text-success border border-success/30 rounded-badge">Current</span>}
              </div>
              <p class="text-xs text-[var(--text-dim)] mb-2">{exp.company} · {exp.timeline} · {exp.location}</p>
              <ul class="space-y-1">
                {exp.highlights.map(h => (
                  <li class="text-sm text-[var(--text-muted)] flex items-baseline gap-2">
                    <span class="text-accent flex-shrink-0">&#x25B8;</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </Card>
        ))}
      </div>
    </section>


    <!-- Education -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[var(--border)]">
      <p class="text-accent text-xs font-mono tracking-widest uppercase mb-3">EDUCATION</p>
      <h2 class="text-2xl font-semibold text-[var(--text)] mb-8">Education</h2>
      <div class="space-y-4">
        {experience.filter(exp => exp.type === 'Education').map(exp => (
          <Card padding="5" class="flex flex-col sm:flex-row sm:items-start gap-4">
            {exp.pic && <a href={exp.pic} class="flex-shrink-0"><Image src={resolveImage(exp.pic)} alt={exp.company} width={112} height={112} fit="contain" loading="lazy" decoding="async" class="w-14 h-14 object-contain rounded-badge hover:opacity-80 transition-all duration-300" /></a>}
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <h3 class="text-[var(--text)] font-semibold text-sm">{exp.title}</h3>
                {exp.current && <span class="text-[10px] px-2 py-0.5 bg-success/20 text-success border border-success/30 rounded-badge">Current</span>}
              </div>
              <p class="text-xs text-[var(--text-dim)] mb-2">{exp.company} · {exp.timeline} · {exp.location}</p>
              <ul class="space-y-1">
                {exp.highlights.map(h => (
                  <li class="text-sm text-[var(--text-muted)] flex items-baseline gap-2">
                    <span class="text-accent flex-shrink-0">&#x25B8;</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </Card>
        ))}
      </div>
    </section>


    <!-- Technical Stack -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[var(--border)]">
      <p class="text-accent text-xs font-mono tracking-widest uppercase mb-3">TOOLKIT</p>
      <h2 class="text-2xl font-semibold text-[var(--text)] mb-8">Tools &amp; Technologies</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {skills.groups.map(group => (
          <Card padding="5">
            <h3 class="text-sm font-semibold text-[var(--text)] mb-3">{group.category}</h3>
            <div class="flex flex-wrap gap-2">
              {group.tools.map(tool => (
                <span class="text-xs px-2.5 py-1 border border-[var(--border)] rounded-badge text-[var(--text-muted)] bg-[var(--bg-elevated)]">{tool}</span>
              ))}
            </div>
          </Card>
        ))}
      </div>
    </section>


    <!-- Security Profile -->
    <section id="profile" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[var(--border)] scroll-mt-20">
      <p class="text-accent text-xs font-mono tracking-widest uppercase mb-3">PROFILE</p>
      <h2 class="text-2xl font-semibold text-[var(--text)] mb-8">Security Profile</h2>
      <Card padding="6">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {profile.gpa && <div>
            <p class="text-xs text-[var(--text-dim)] uppercase tracking-wider mb-1">GPA</p>
            <p class="text-sm text-[var(--text)]">{profile.gpa}</p>
          </div>}
          {profile.graduationYear && <div>
            <p class="text-xs text-[var(--text-dim)] uppercase tracking-wider mb-1">Graduation</p>
            <p class="text-sm text-[var(--text)]">{profile.graduationYear}</p>
          </div>}
          {profile.location && <div>
            <p class="text-xs text-[var(--text-dim)] uppercase tracking-wider mb-1">Location</p>
            <p class="text-sm text-[var(--text)]">{profile.location}</p>
          </div>}
          {profile.availability && <div>
            <p class="text-xs text-[var(--text-dim)] uppercase tracking-wider mb-1">Availability</p>
            <p class="text-sm text-[var(--text)]">{profile.availability}</p>
          </div>}
          {profile.languages?.length > 0 && <div>
            <p class="text-xs text-[var(--text-dim)] uppercase tracking-wider mb-1">Languages</p>
            <p class="text-sm text-[var(--text)]">{profile.languages.join(' · ')}</p>
          </div>}
        </div>
      </Card>
    </section>


    <!-- Certifications -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[var(--border)]">
      <p class="text-accent text-xs font-mono tracking-widest uppercase mb-3">CERTIFICATIONS</p>
      <h2 class="text-2xl font-semibold text-[var(--text)] mb-8">Certifications & Learning</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {certifications.map(cert => (
          <Card padding="5" class="flex items-center gap-4">
            {cert.pic && <a href={cert.pic} target="_blank" rel="noopener noreferrer" class="flex-shrink-0"><Image src={resolveImage(cert.pic)} alt={cert.name} width={112} height={112} fit="contain" loading="lazy" decoding="async" class="w-14 h-14 object-contain rounded-badge hover:opacity-80 transition-all duration-300" /></a>}
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-semibold text-[var(--text)]">{cert.name}</h3>
              <p class="text-xs text-[var(--text-dim)]">{cert.issuer} · {cert.date}</p>
            </div>
            <span class:list={[
              "text-[10px] px-2 py-0.5 border rounded-badge flex-shrink-0",
              cert.status === 'completed' ? "bg-success/20 text-success border-success/30" : "bg-warning/20 text-warning border-warning/30"
            ]}>
              {cert.status === 'completed' ? 'Completed' : 'In Progress'}
            </span>
          </Card>
        ))}
      </div>
    </section>


    <!-- Recent Blog Preview -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[var(--border)]">
      <div class="flex items-center justify-between mb-8">
        <div>
          <p class="text-accent text-xs font-mono tracking-widest uppercase mb-3">BLOG</p>
          <h2 class="text-2xl font-semibold text-[var(--text)]">Latest Articles</h2>
        </div>
        <a href={`${base}/blog`} class="text-sm text-[var(--text-muted)] hover:text-accent transition-all duration-300">View all &rarr;</a>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {latestBlogs.length > 0 ? latestBlogs.map(post => (
          <Card href={`${base}/blog/${post.slug}`} padding="5" class="group block overflow-hidden">
            {post.pic && <Image src={resolveImage(post.pic)} alt={post.title} width={640} height={360} loading="lazy" decoding="async" class="w-full h-36 object-cover" />}
            <div class="p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[10px] px-2 py-0.5 bg-accent/20 text-accent border border-accent/30 rounded-badge">{post.category}</span>
              <span class="text-[10px] text-[var(--text-dim)]">{post.readingTime} min read</span>
            </div>
            <h3 class="text-[var(--text)] font-semibold text-sm mb-2 group-hover:text-accent transition-all duration-300">{post.title}</h3>
            <p class="text-sm text-[var(--text-muted)] line-clamp-2">{post.description}</p>
            </div>
          </Card>
        )) : (
          <p class="text-sm text-[var(--text-dim)] col-span-2">Articles coming soon.</p>
        )}
      </div>
    </section>

  </main>

  <Footer />
</Layout>
